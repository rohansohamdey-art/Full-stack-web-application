<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <div class="col-8 offset-2">
    
    <h3>Edit Listing:</h3>

    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

        <div>
            <label for="title" class="form-label">Title:</label>
            <input type="text" name="listing[title]" value="<%= listing.title %>" class="form-control" required>
            <div class="invalid-feedback">  Please enter the title! </div><br>
        </div>

        <div>
            <label for="description" class="form-label">Description:</label>
            <input name="listing[description]"value= "<%= listing.description %>" class="form-control" required>
            <div class="invalid-feedback">  Please enter the short description! </div><br>
        </div>

        <div>
            Original Listing Image: <br>
            <img src="<%= originalImageUrl %>">
        </div> <br>

        <div>
            <label for="image" class="form-label">Upload New Image</label>
            <input type="file" name="listing[image]" class="form-control">
            <!-- <div class="invalid-feedback">  Please upload an image! </div> --> <br>
        </div>

        <div class="row">

        <div class="col-md-4">
            <label for="price" class="form-label">Price:</label>
            <input type="number"  name="listing[price]" value="<%= listing.price %>" class="form-control" required>
            <div class="invalid-feedback">  Please enter the valid price! </div><br>
        </div>

        <div class="col-md-8">
            <label for="country" class="form-label">Country:</label>
            <input type="text"  name="listing[country]" value="<%= listing.country %>" class="form-control" required>
            <div class="invalid-feedback">  Please enter your country! </div><br>
        </div>

        </div>

        <div>
            <label for="location" class="form-label">Location:</label>
            <input type="text"  name="listing[location]" value="<%= listing.location %>" class="form-control" required>
            <div class="invalid-feedback">  Please enter your location! </div><br>
        </div>

        <button class="btn btn-dark add-btn mt-3">Update Listing..</button>

    </form>

        </div>
    </div>  <br>


